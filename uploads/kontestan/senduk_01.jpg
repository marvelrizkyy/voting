<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500" width="400" height="500">
  <defs>
    <linearGradient id="sendukBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#223663"/>
      <stop offset="60%" stop-color="#121D38"/>
      <stop offset="100%" stop-color="#0B1224"/>
    </linearGradient>
    <linearGradient id="goldSash" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F5D78E"/>
      <stop offset="50%" stop-color="#D6AE58"/>
      <stop offset="100%" stop-color="#9C7221"/>
    </linearGradient>
    <radialGradient id="sendukAura" cx="50%" cy="35%" r="45%">
      <stop offset="0%" stop-color="#D6AE58" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#101B35" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <!-- Background Canvas -->
  <rect width="400" height="500" fill="url(#sendukBg)"/>
  <circle cx="200" cy="180" r="160" fill="url(#sendukAura)"/>

  <!-- Ornaments -->
  <g opacity="0.12" stroke="#D6AE58" stroke-width="1.5" fill="none">
    <circle cx="200" cy="180" r="140" stroke-dasharray="6 6"/>
    <circle cx="200" cy="180" r="115"/>
  </g>

  <!-- Senduk Silhouette -->
  <g transform="translate(0, 20)">
    <!-- Shoulders & Kebaya -->
    <path d="M85 480 C85 390 130 325 200 325 C270 325 315 390 315 480 Z" fill="#1C2847"/>
    <path d="M120 480 C120 380 150 340 200 340 C250 340 280 380 280 480 Z" fill="#24345B"/>

    <!-- Slender Neck -->
    <path d="M182 265 L182 335 L218 335 L218 265 Z" fill="#DEB490"/>
    <!-- Gold Necklace / Choker -->
    <path d="M182 315 Q200 325 218 315" stroke="url(#goldSash)" stroke-width="3" fill="none"/>

    <!-- Pageant Gold Sash -->
    <path d="M125 365 L275 480 L308 480 L150 350 Z" fill="url(#goldSash)" opacity="0.95"/>
    <text x="215" y="425" font-family="'Poppins', sans-serif" font-size="11" font-weight="700" fill="#101B35" transform="rotate(38 215 425)" letter-spacing="2">SENDUK PONOROGO</text>

    <!-- Hair Bun (Sanggul Jawa) in Background -->
    <ellipse cx="200" cy="205" rx="72" ry="60" fill="#1A110D"/>

    <!-- Head & Face -->
    <ellipse cx="200" cy="225" rx="46" ry="56" fill="#E8C09C"/>

    <!-- Front Sanggul Hairline -->
    <path d="M154 210 C154 165 175 160 200 160 C225 160 246 165 246 210 C235 185 215 180 200 180 C185 180 165 185 154 210 Z" fill="#1A110D"/>

    <!-- Tiara & Cunduk Mentul (Crown Ornaments) -->
    <!-- Center Tiara -->
    <path d="M180 168 L190 150 L200 142 L210 150 L220 168 Q200 164 180 168 Z" fill="url(#goldSash)"/>
    <!-- Cunduk Mentul Petals (Khas Duta Wisata Senduk) -->
    <line x1="200" y1="142" x2="200" y2="105" stroke="url(#goldSash)" stroke-width="2"/>
    <circle cx="200" cy="102" r="7" fill="url(#goldSash)"/>

    <line x1="188" y1="148" x2="175" y2="115" stroke="url(#goldSash)" stroke-width="1.8"/>
    <circle cx="173" cy="113" r="6" fill="url(#goldSash)"/>

    <line x1="212" y1="148" x2="225" y2="115" stroke="url(#goldSash)" stroke-width="1.8"/>
    <circle cx="227" cy="113" r="6" fill="url(#goldSash)"/>

    <!-- Melati Garland Accent (Untaian Bunga Melati di Bahu) -->
    <g fill="#FFFFFF" opacity="0.9">
      <circle cx="160" cy="255" r="4"/>
      <circle cx="158" cy="270" r="4.5"/>
      <circle cx="159" cy="286" r="4.5"/>
      <circle cx="162" cy="302" r="5"/>
      <circle cx="166" cy="320" r="5"/>
      <circle cx="170" cy="338" r="4.5"/>
    </g>
  </g>

  <!-- Frame border -->
  <rect x="10" y="10" width="380" height="480" fill="none" stroke="url(#goldSash)" stroke-width="1.5" rx="12" opacity="0.4"/>
  <text x="200" y="475" text-anchor="middle" font-family="'Playfair Display', Georgia, serif" font-size="16" font-weight="700" fill="url(#goldSash)" letter-spacing="3">CALON SENDUK</text>
</svg>
